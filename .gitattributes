# Auto-detect text files and ensure LF line endings across all platforms
* text=auto eol=lf

# Source code
*.c text eol=lf
*.h text eol=lf
*.swift text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.ppd text eol=lf
*.xml text eol=lf
*.plist text eol=lf
*.json text eol=lf
*.md text eol=lf
Makefile text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.icns binary
*.icc binary
*.dylib binary
*.a binary
*.pkg binary
*.dmg binary
*.pdf binary
*.ppm binary
